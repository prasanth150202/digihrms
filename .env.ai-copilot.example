# ── DigiHRMS AI Copilot (beta) ───────────────────────────────────────────
# Append these lines to the real .env on the server (digihrms/.env).

# OpenRouter — https://openrouter.ai/keys  (free tier is fine)
OPENROUTER_API_KEY=

# Any tool-calling-capable model. Free options that work today:
#   deepseek/deepseek-chat-v3-0324:free
#   meta-llama/llama-3.3-70b-instruct:free
#   qwen/qwen-2.5-72b-instruct:free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Swap this to run against a LAN box instead of OpenRouter, e.g. Ollama:
#   OPENROUTER_BASE_URL=http://192.168.1.50:11434/v1
#   OPENROUTER_API_KEY=ollama
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Show non-SELECT SQL for a Run/Skip confirmation before it executes.
# Destructive statements (DROP/TRUNCATE/WHERE-less DELETE...) always confirm.
AI_AGENT_CONFIRM_WRITES=true
